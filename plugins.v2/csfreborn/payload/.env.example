SF_API_TOKEN=replace-with-a-long-random-token
SF_MEDIA_ROOTS=/media
SF_DATA_DIR=/data
SF_PROVIDER_ORDER=subtitle_best,opensubtitles,assrt,custom
SF_SUBTITLE_BEST_API_KEY=
SF_SUBTITLE_BEST_HEADER_TOKEN=
SF_OPENSUBTITLES_API_KEY=
SF_OPENSUBTITLES_USERNAME=
SF_OPENSUBTITLES_PASSWORD=
SF_ASSRT_TOKEN=
SF_CUSTOM_PROVIDER_URL=
SF_CUSTOM_PROVIDER_TOKEN=
SF_ALLOW_MACHINE_TRANSLATED=false
SF_REQUEST_TIMEOUT_SECONDS=30
SF_MAX_DOWNLOAD_MB=80
SF_FFPROBE_PATH=ffprobe

# Host path mapped to the container's /media directory by docker-compose.yml.
MEDIA_ROOT=/volume1/media
